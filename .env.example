# ===========================================
# Конфигурация Catalog Validator
# ===========================================
# Скопируйте этот файл в .env и заполните своими значениями

# OpenAI API ключ (ОБЯЗАТЕЛЬНО! получить на https://platform.openai.com/api-keys)
LLM_API_KEY=sk-your-openai-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here

# API endpoint (для OpenAI оставьте как есть)
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Модель (рекомендуется gpt-4-turbo для баланса цена/качество)
# Варианты: gpt-4-turbo, gpt-4, gpt-3.5-turbo
LLM_MODEL=gpt-4-turbo

# URL semantic service (оставьте как есть)
SEMANTIC_URL=http://127.0.0.1:8000/analyze-category

# ===========================================
# Настройки сервера (для сетевого доступа)
# ===========================================

# Хост сервера (0.0.0.0 для доступа по сети, 127.0.0.1 только локально)
SERVER_HOST=0.0.0.0

# Порт сервера
SERVER_PORT=8080

# Окружение (production или development)
ENVIRONMENT=production

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
